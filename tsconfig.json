{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "jsx": "react-jsx",
    "moduleDetection": "force",

    "types": ["bun", "vite/client"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "apps/dashboard/src/**/*.ts", "apps/dashboard/src/**/*.tsx", "apps/dashboard/vite.config.ts"]
}
